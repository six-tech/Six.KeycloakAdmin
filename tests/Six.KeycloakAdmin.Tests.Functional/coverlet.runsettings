<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura;html;json</Format>
          <!-- Output will be dynamically set by MSBuild properties -->
          <ExcludeByFile>**/bin/**/*,**/obj/**/*,**/test/**/*</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
          <Include>**/*.cs</Include>
          <Exclude>**/*.g.cs,**/*.g.i.cs,**/*.Designer.cs,**/*.AssemblyInfo.cs</Exclude>
          <IncludeDirectories>../../libs/Six.KeycloakAdmin/src/**/*</IncludeDirectories>
          <ExcludeDirectories>**/bin/**,**/obj/**,**/test/**</ExcludeDirectories>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
  <RunConfiguration>
    <ResultsDirectory>TestResults</ResultsDirectory>
    <CollectSourceInformation>true</CollectSourceInformation>
  </RunConfiguration>
</RunSettings>
