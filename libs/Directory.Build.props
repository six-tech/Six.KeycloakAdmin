<!-- Directory.Build.props for libraries -->
<Project>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <NoWarn>CS1591;CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>

        <!-- Global Version -->
        <SixPackageVersion>1.0.0-alpha.4</SixPackageVersion>
        <Version>$(SixPackageVersion)</Version>

        <!-- Global Packaging Info -->
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Authors>Six Technology</Authors>
        <Copyright>Copyright (c) Six Technology 2025</Copyright>
        <Description>.NET admin client for Keycloak. Gives programmatical access to Keycloak's admin API.</Description>

        <SignAssembly>true</SignAssembly>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageProjectUrl>https://six.technology</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/six-tech/Six.KeycloakAdmin</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>package_icon.png</PackageIcon>


        <!-- 
        Debug Symbols         
        It’s important to include debug information in your package for better maintainability and support. 
        This typically involves setting the correct debug type in your project files.
        
        If you wany to embed the PDBs in the package, you can set the DebugType property to 'embedded'.
        See more: https://github.com/dotnet/sourcelink 
        -->
        <DebugType>portable</DebugType>

        <!-- Enable Source Link -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- Deterministic build -->
        <Deterministic>true</Deterministic>


        <!-- 
            Uncomment to enable Validation 
            https://learn.microsoft.com/en-us/dotnet/fundamentals/package-validation/overview       
            <EnablePackageValidation>true</EnablePackageValidation>
        
            Uncomment to validate against some previous package (API changes) 
            https://docs.microsoft.com/en-us/nuget/reference/msbuild-targets#packagevalidationbaselineversion
            <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
        -->

        <!-- 
            XML Documentation
            Also turn off warnings for missing documentation 
        -->
        <GenerateDocumentationFile>True</GenerateDocumentationFile>


        <!--
            Starting in the .NET 8 SDK, PackRelease defaults to true. For more information, 
            see 'dotnet pack' uses Release configuration.
            
            .NET 7 SDK only: To use PackRelease in a project that's part of a Visual Studio solution, 
            you must set the environment variable DOTNET_CLI_ENABLE_PACK_RELEASE_FOR_SOLUTIONS to true 
            (or any other value). For solutions that have many projects, setting this variable 
            increases the time required to pack.
        -->
        <PackRelease>true</PackRelease>

    </PropertyGroup>

    <ItemGroup>
        <!-- To enable source links on GitHub -->
        <!-- See: https://github.com/dotnet/sourcelink-->
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All"/>

        <!-- This version could have problems with source generators -->
        <!--        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>-->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.0"/>
    </ItemGroup>

    <!--
        To include the README.md file in the packages
    -->
    <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.shproj'">
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="package_icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>